# ── AquaCount web app build settings ─────────────────────────────────────────
# Leave everything empty when the app is served by the AquaCount backend
# (hatchery laptop) or run with `npm run dev` (Vite proxies to the backend).

# Backend for data, uploads and the live Socket.IO stream. Empty = same origin.
# Vercel + Render: https://aquacount-backend.onrender.com
VITE_API_URL=

# Backend for /api/auth (sign-in, refresh cookie). Empty = same origin, which on
# Vercel is proxied to Render by vercel.json so the session cookie is first-party.
VITE_AUTH_URL=

# Dev only: where `npm run dev` proxies /api and /socket.io.
VITE_DEV_BACKEND=http://localhost:5000
