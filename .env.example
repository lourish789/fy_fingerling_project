# ─────────────────────────────────────────────────────────────────────────────
# AquaCount backend settings (accounts, sign-in, web app)
# Every value is optional on the hatchery laptop: the defaults keep accounts in
# instance/aquacount.db and a signing key in instance/secret_key, offline.
# On Render, set these in the dashboard (see render.yaml). Never commit a .env.
# The web app's own build settings are in web/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Signs session tokens. Long and random; changing it signs everyone out.
JWT_SECRET=

# Accounts, sessions and run ownership. Default: SQLite in instance/.
# Hosted (Render free tier wipes its disk): an external Postgres, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/aquacount
DATABASE_URL=

# "Continue with Google": OAuth 2.0 client ID of type "Web application".
# Authorised JavaScript origins = every address the app is opened from.
GOOGLE_CLIENT_ID=

# 1 (default) lets anyone create an account; the first account becomes admin.
ALLOW_SIGNUP=1
# Comma-separated emails that are always administrators.
ADMIN_EMAILS=

# Public address of the web app (password-reset links). Required with SMTP.
APP_URL=
# Browser origins allowed to call the API, comma-separated. Default: any.
CORS_ORIGINS=
# 1 behind a reverse proxy (Render, nginx): trust X-Forwarded-For / -Proto.
TRUST_PROXY=0

# Session lengths.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Refresh cookie. Lax works same-origin and through the Vercel proxy; use None
# only if the app calls /api/auth on another site directly (needs HTTPS).
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=auto

# Password-reset email. Without SMTP the reset link is printed in the server
# window, where the station administrator can pass it on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
